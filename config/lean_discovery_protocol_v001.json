  "candidate_selection": {
    "selection_cutoff": "09:25:00_America/New_York_exclusive",
    "direction": "sign_of_premarket_gap_zero_is_ineligible",
    "rules": [
      {"id": "absolute_premarket_gap", "definition": "absolute(last_eligible_09:24_bar_close/prior_regular_session_close-1)", "operator": ">=", "value": 0.04},
      {"id": "cutoff_price", "definition": "last_eligible_premarket_bar_close_at_or_before_09:24", "operator": "between_inclusive", "value": [1.0, 100.0]},
      {"id": "premarket_dollar_volume", "definition": "sum(bar_vwap_times_volume)_04:00_inclusive_to_09:25_exclusive", "operator": ">=", "value": 250000.0},
      {"id": "premarket_relative_volume", "definition": "premarket_share_volume_divided_by_median_same_clock_window_volume_over_prior_20_bound_sessions", "operator": ">=", "value": 2.0},
      {"id": "prior_liquidity", "definition": "median_regular_session_dollar_volume_over_prior_20_bound_sessions", "operator": ">=", "value": 5000000.0}
    ],
    "warmup": "20_prior_bound_sessions_with_at_least_15_complete_observations_for_each_baseline",
    "corporate_action_rule": "exclude_any_window_with_unresolved_split_reverse_split_or_price_discontinuity_conflict",
    "gap_rule": "exclude_missing_09:24_reference_or_prior_close_and_never_forward_fill",
    "selection_only": true
  },
  "feature_registry": [
    {"id": "distance_from_premarket_high", "observation_window": "04:00:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "gap_direction_times(reference_price_at_09:45/premarket_high_before_09:25-1)", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "first_pullback_depth", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "gap_aligned_maximum_retracement_from_first_directional_extreme_using_left_labeled_bars", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "gap_aligned_opening_return", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "gap_direction_times(last_price_before_cutoff/first_price_at_or_after_open-1)", "missing_rule": "exclude_event_from_primary_analysis"},
    {"id": "market_relative_return", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "gap_aligned_opening_return_minus_gap_direction_times_SPY_return_over_same_window", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "missing_minute_count", "observation_window": "04:00:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "count_expected_left_labeled_minutes_without_a_bar_or_explicit_no_trade_state", "missing_rule": "exclude_event_when_count_exceeds_2_in_opening_window"},
    {"id": "opening_realized_volatility", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "root_sum_squared_one_minute_log_returns_without_annualization", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "opening_volume_acceleration", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "mean_share_volume_09:40_to_09:45_divided_by_mean_share_volume_09:30_to_09:40", "missing_rule": "exclude_zero_denominator_or_incomplete_window"},
    {"id": "opening_vwap_distance", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "gap_direction_times(last_price_before_cutoff/opening_window_vwap-1)", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "opening_window_dollar_volume", "observation_window": "09:30:00_to_09:45:00_America/New_York_end_exclusive", "cutoff": "09:45:00", "definition": "sum(bar_vwap_times_volume)", "missing_rule": "exclude_event_from_feature_analysis"},
    {"id": "provider_halt_or_gap_indicator", "observation_window": "04:00:00_to_scheduled_close_end_exclusive", "cutoff": "scheduled_close", "definition": "explicit_provider_halt_when_available_or_unexplained_consecutive_missing_minute_run_flag_without_claiming_halt_absence", "missing_rule": "unknown_status_is_retained_and_excluded_in_halt_sensitive_analysis"}
  ],
  "outcome_registry": [
    {"id": "close_to_reference_return", "observation_window": "09:45:00_to_scheduled_close_end_exclusive", "definition": "gap_direction_times(last_eligible_regular_price/reference_price-1)", "missing_rule": "exclude_if_close_or_reference_is_missing"},
